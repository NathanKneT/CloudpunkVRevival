<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>CloudpunkVR</AssemblyName>
    <RootNamespace>CloudpunkVR</RootNamespace>
    <!-- openvr_api.cs from Valve uses obsolete marshalling attributes; keep the build quiet about them. -->
    <NoWarn>$(NoWarn);CS0618;CS0649;CS0169;CS8981;SYSLIB1054</NoWarn>
  </PropertyGroup>

  <!-- tools/build.ps1 -Dev: developer commands and probes, for testing. Never in a release. -->
  <PropertyGroup Condition="'$(DevBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);DEV</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core"><HintPath>$(BepInExCore)\BepInEx.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.IL2CPP"><HintPath>$(BepInExCore)\BepInEx.Unity.IL2CPP.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.Common"><HintPath>$(BepInExCore)\BepInEx.Unity.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(BepInExCore)\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Common"><HintPath>$(BepInExCore)\Il2CppInterop.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Game and Unity assemblies generated by BepInEx (Il2CppInterop) on first launch. -->
    <InteropRef Include="Il2Cppmscorlib;Il2CppSystem;Il2CppSystem.Core;Assembly-CSharp;Assembly-CSharp-firstpass;InControl;Cinemachine;Unity.Postprocessing.Runtime;Unity.TextMeshPro;UnityEngine;UnityEngine.CoreModule;UnityEngine.UI;UnityEngine.UIModule;UnityEngine.IMGUIModule;UnityEngine.TextRenderingModule;UnityEngine.VRModule;UnityEngine.XRModule;UnityEngine.PhysicsModule;UnityEngine.AnimationModule;UnityEngine.AudioModule;UnityEngine.ParticleSystemModule;UnityEngine.ImageConversionModule;UnityEngine.DirectorModule;com.rlabrecque.steamworks.net;uCurve" />
    <Reference Include="@(InteropRef)">
      <HintPath>$(Interop)\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\bindings\*.json" Link="bindings\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\third_party\openvr\openvr_api.dll" Link="openvr_api.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
